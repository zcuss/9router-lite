{
  "name": "zcusrouter",
  "version": "0.4.76",
  "bin": {
    "zcus-9router": "./cli.js",
    "zcusrouter": "./cli.js"
  },
  "description": "Zcus Router CLI - Start and manage Zcus Router server",
  "files": [
    "cli.js",
    "src",
    "hooks",
    "app",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "nodemon -I --watch cli.js --watch src --watch hooks --ext js,json cli.js",
    "build": "node scripts/build-cli.js",
    "pack:cli": "npm run build && npm pack --pack-destination ../..",
    "publish:cli": "npm run build && npm publish",
    "postinstall": "node hooks/postinstall.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@xyflow/react": "^12.10.1",
    "bcryptjs": "^3.0.3",
    "confbox": "^0.2.4",
    "enquirer": "^2.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "fs": "^0.0.1-security",
    "http-proxy-middleware": "^3.0.5",
    "jose": "^6.1.3",
    "marked": "^18.0.1",
    "material-symbols": "^0.44.6",
    "monaco-editor": "^0.55.1",
    "next": "^16.1.6",
    "next-intl": "^4.13.0",
    "node-forge": "^1.3.3",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "lucide-react": "^0.469.0",
    "nodemailer": "^6.9.16",
    "prop-types": "^15.8.1",
    "ora": "^9.1.0",
    "pg": "^8.16.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-is": "^16.13.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^5.5.0",
    "socks-proxy-agent": "^8.0.5",
    "sonner": "^2.0.7",
    "undici": "^7.19.2",
    "uuid": "^13.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.10"
  },
  "comment_systray": "systray2 is NOT bundled here. It is lazy-installed into ~/.9router/runtime/node_modules by hooks/postinstall.js on macOS/Linux only. Windows uses PowerShell NotifyIcon (zero binary). This avoids shipping unsigned Go binaries that trigger antivirus false positives (Kaspersky). We use the systray2 fork because the legacy systray@1.0.5 ships a 2017 x86_64 binary that fails on modern macOS dyld.",
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "9router",
    "cli",
    "proxy",
    "ai",
    "api"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "nodemon": "^3.1.14"
  }
}